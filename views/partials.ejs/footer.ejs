<body>
    

<footer class="cure-footer">
    <div class="footer-container">

      <!-- About -->
      <div class="footer-section">
        <h3>CureChain</h3>
        <p>CureChain is a trusted platform connecting donors and NGOs to deliver unused
          medicines safely to people in need.</p>
      </div>

      <!-- Quick Links -->
      <div class="footer-section">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="#">Home</a></li>
          <li><a href="#">How CureChain Works</a></li>
          <li><a href="#">Donate Medicine</a></li>
