          <li><a href="#">Contact</a></li>
        </ul>
      </div>

      <!-- Feedback -->
      <div class="footer-section">
        <h3>Feedback</h3>
        <form class="feedback-form">
          <input type="text" placeholder="Your Name" required style="border-radius: 1.3rem;">
          <input type="email" placeholder="Your Email" required style="border-radius: 1.3rem;">
          <textarea placeholder="Your Feedback..." required style="border-radius: 1.3rem;"></textarea>
          <button type="submit" style="border-radius: 1.3rem;">Submit</button>
        </form>
      </div>

      <!-- Social -->
